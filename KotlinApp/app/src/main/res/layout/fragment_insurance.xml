<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            android:text="Choose Your Insurance"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_semibold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Opciones -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBasic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Basic Coverage"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvPriceBasic"
                    android:text="Cost: $15/day"
                    android:textColor="#777777" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStandard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Standard Protection"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvPriceStandard"
                    android:text="Cost: $25/day"
                    android:textColor="#777777" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Premium Full Insurance"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvPricePremium"
                    android:text="Cost: $40/day"
                    android:textColor="#777777" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Input -->
        <EditText
            android:id="@+id/etUsageDay"
            android:hint="Enter day of rental (1-31)"
            android:inputType="number"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:background="@drawable/rounded_input_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRecommend"
            android:text="Recommend Insurance"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvRecommendation"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:textColor="#555555" />
    </LinearLayout>
</ScrollView>
